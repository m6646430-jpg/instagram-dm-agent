# Long-lived Instagram access token for your account (see README, Setup)
IG_ACCESS_TOKEN=

# Instagram professional account ID (a long number, shown next to the account
# in the app's Instagram API setup page)
IG_USER_ID=

# graph.facebook.com for Unified login (new apps); graph.instagram.com for the
# older Instagram login
IG_API_BASE=https://graph.facebook.com/v23.0

# 1 = only print what would be sent. Change to 0 to send for real.
DRY_RUN=1

# Optional public comment reply after the DM is sent. Leave empty for none.
# Several replies separated by | are rotated.
PUBLIC_REPLY=

MEDIA_LIMIT=15
MAX_SENDS_PER_RUN=30
POLL_SECONDS=300

# 1 = also answer keywords sent as a DM. 0 = comments only.
DM_REPLIES=1
CONVERSATION_LIMIT=25
