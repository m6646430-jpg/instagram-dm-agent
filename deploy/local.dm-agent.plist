<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace /PATH/TO/dm-agent (4 places) with the full path of this folder,
     then copy this file to ~/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.dm-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/PATH/TO/dm-agent/agent.py</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/dm-agent</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/PATH/TO/dm-agent/agent.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/dm-agent/agent.log</string>
</dict>
</plist>
